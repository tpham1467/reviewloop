 package fetch
 
-import "net/http"
+import (
+	"io"
+	"net/http"
+)
 
 var client = &http.Client{}
+
+func Body(url string) ([]byte, error) {
+	resp, err := client.Get(url)
+	defer resp.Body.Close()
+	if err != nil {
+		return nil, err
+	}
+	return io.ReadAll(resp.Body)
+}
