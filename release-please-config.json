{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "reviewloop-ai",
      "bump-minor-pre-major": true,
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "generic",
          "path": "action.yml"
        },
        {
          "type": "generic",
          "path": "templates/reviewloop.yml"
        },
        {
          "type": "generic",
          "path": "src/reviewloop/__init__.py"
        },
        {
          "type": "generic",
          "path": "examples/bitbucket-pipelines.yml"
        },
        {
          "type": "generic",
          "path": "examples/Jenkinsfile"
        },
        {
          "type": "generic",
          "path": "src/reviewloop/cli_snippets.py"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value==\"reviewloop-ai\")].version"
        }
      ]
    }
  }
}
